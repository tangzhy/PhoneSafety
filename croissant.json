  "rai:dataCollection": "Safety-critical states were selected from 4,512 human-executed Android trajectories (~75K steps, more than 130 source apps).",
  "rai:dataCollectionType": [
    "Real-device trajectories",
    "Human case-validity review",
    "Partly machine-generated reference actions"
  ],
  "rai:dataAnnotationProtocol": [
    "Safe and unsafe references were inherited from earlier review or generated by Method B using the task, history, screenshot context and active protocol, as described in the paper."
  ],
  "rai:dataBiases": [
    "Chinese Android interfaces and authorization conventions shape the case distribution.",
    "Human task execution and targeted scenario expansion shape which critical states are selected.",
    "Paired protocol-dependent references do not enumerate all acceptable actions."
  ],
  "rai:dataUseCases": [
    "Offline next-action evaluation at safety-critical phone states.",
    "Diagnostic comparison of safe, unsafe and unmatched actions under an explicit protocol."
  ],
  "rai:hasSyntheticData": true,
  "rai:personalSensitiveInformation": "The data contain Chinese-language Android task instructions, interaction histories, and app screenshots from controlled task execution. The scenarios include contact, payment, and permission interfaces. Privacy handling is described in the paper checklist under Safeguards. Some data points were removed from the public release to comply with company requirements.",
  "rai:dataLimitations": [
    "Public release contains 640 of the 700 research cases.",
    "Empirical coverage is Chinese Android; the dataset does not evaluate full online trajectories or unseen app versions."
  ],
  "rai:dataSocialImpact": "The benchmark supports diagnostic evaluation of safe, unsafe, and unmatched actions at authorization boundaries.",
